# Database module for the MoldX playground.
#
# Runs PostgreSQL in Docker. Commands:
#   moldx docker build database
#   moldx docker start database
#   moldx docker stop database
#   moldx database seed
#
# The .env file (copied from .env.example) provides connection settings.
DATABASE_NAME=playground
DATABASE_USER=playground
DATABASE_PASSWORD=playground
DATABASE_PORT=5432
